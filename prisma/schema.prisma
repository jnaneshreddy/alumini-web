generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum GalleryType {
  PHOTO_GALLERY
  MEMORY
}

enum GalleryCategory {
  SCHOOL_MEMORIES
  CAMPUS
  EVENTS
  ALUMNI
  REUNIONS
  TEACHERS
  STUDENT_LIFE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum AlumniVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AlumniRegistrantType {
  ALUMNI
  STUDENT
  TEACHER
}

enum MclSeasonStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model UserProfile {
  id                String                 @id @default(uuid())
  authUserId        String                 @unique
  email             String                 @unique
  fullName          String
  role              Role                   @default(USER)
  active            Boolean                @default(true)
  phone             String?
  batch             String?
  avatarUrl         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  transactions      FinancialTransaction[]
  auditLogs         AuditLog[]
  galleryImages     GalleryImage[]
  alumniCreated     AlumniProfile[]        @relation("AlumniCreatedBy")
  alumniVerified    AlumniProfile[]        @relation("AlumniVerifiedBy")
  notifications     AdminNotification[]
  settingsUpdates   SiteSettings[]         @relation("SettingsUpdatedBy")
  teachersCreated   Teacher[]              @relation("TeacherCreatedBy")
  teachersUpdated   Teacher[]              @relation("TeacherUpdatedBy")
  mclSeasonsCreated MclSeason[]            @relation("MclSeasonCreatedBy")
  mclSeasonsUpdated MclSeason[]            @relation("MclSeasonUpdatedBy")
  mclMemories       MclMemory[]            @relation("MclMemoryUploadedBy")

  @@map("user_profiles")
}

model AlumniProfile {
  id                 String                   @id @default(uuid())
  fullName           String
  registrantType     AlumniRegistrantType     @default(ALUMNI)
  email              String?
  phone              String?
  batch              String
  graduationYear     Int?
  city               String?
  profession         String?
  bio                String?
  avatarUrl          String?
  consentToPublish   Boolean                  @default(false)
  consentRecordedAt  DateTime?
  verificationStatus AlumniVerificationStatus @default(PENDING)
  isPublished        Boolean                  @default(false)
  createdById        String?
  verifiedById       String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  createdBy          UserProfile?             @relation("AlumniCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedBy         UserProfile?             @relation("AlumniVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  mclPlayers         MclPlayer[]

  @@index([batch, verificationStatus])
  @@index([isPublished, verificationStatus])
  @@map("alumni_profiles")
}

model AdminNotification {
  id          String      @id @default(uuid())
  recipientId String
  title       String
  message     String
  category    String      @default("SYSTEM")
  href        String?
  readAt      DateTime?
  clearedAt   DateTime?
  createdAt   DateTime    @default(now())
  recipient   UserProfile @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, clearedAt, createdAt])
  @@index([recipientId, readAt])
  @@map("admin_notifications")
}

model SiteSettings {
  id               String       @id
  organizationName String       @default("Morarji Desai Residential School")
  portalName       String       @default("MDRS Alumni")
  supportEmail     String?
  supportPhone     String?
  timezone         String       @default("Asia/Kolkata")
  notifyFeedback   Boolean      @default(true)
  notifyAlumni     Boolean      @default(true)
  notifyAccess     Boolean      @default(true)
  updatedById      String?
  updatedAt        DateTime     @updatedAt
  updatedBy        UserProfile? @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model CarouselSlide {
  id        String        @id @default(uuid())
  title     String
  caption   String?
  imagePath String
  altText   String
  position  Int           @default(0)
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, position])
  @@map("carousel_slides")
}

model Announcement {
  id          String        @id @default(uuid())
  title       String
  titleKn     String?
  body        String
  bodyKn      String?
  priority    String        @default("GENERAL")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("announcements")
}

model Event {
  id            String                 @id @default(uuid())
  title         String
  titleKn       String?
  description   String?
  descriptionKn String?
  eventDate     DateTime
  startTime     String?
  endTime       String?
  venue         String?
  venueKn       String?
  imagePath     String?
  status        EventStatus            @default(UPCOMING)
  publication   PublishStatus          @default(DRAFT)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  transactions  FinancialTransaction[]
  galleryImages GalleryImage[]

  @@index([eventDate, publication])
  @@map("events")
}

model GalleryImage {
  id            String          @id @default(uuid())
  titleEn       String?
  titleKn       String?
  descriptionEn String?
  descriptionKn String?
  altText       String
  imageUrl      String
  storagePath   String?         @unique
  thumbnailUrl  String?
  category      GalleryCategory @default(SCHOOL_MEMORIES)
  galleryType   GalleryType     @default(PHOTO_GALLERY)
  eventId       String?
  date          DateTime?
  isFeatured    Boolean         @default(false)
  isPublished   Boolean         @default(false)
  sortOrder     Int             @default(0)
  uploadedById  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  event         Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploadedBy    UserProfile?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([galleryType, isPublished, isFeatured, sortOrder])
  @@index([category, isPublished])
  @@index([eventId])
  @@map("gallery_images")
}

model Teacher {
  id            String       @id @default(uuid())
  nameEn        String
  nameKn        String?
  designationEn String
  designationKn String?
  descriptionEn String?
  descriptionKn String?
  imageUrl      String
  storagePath   String?      @unique
  startYear     Int
  endYear       Int?
  isCurrent     Boolean      @default(false)
  isPublished   Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String?
  updatedById   String?
  createdBy     UserProfile? @relation("TeacherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     UserProfile? @relation("TeacherUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublished, isCurrent, endYear, startYear])
  @@map("teachers")
}

model MclSeason {
  id                 String          @id @default(uuid())
  year               Int             @unique
  titleEn            String
  titleKn            String?
  descriptionEn      String?
  descriptionKn      String?
  detailedEn         String?
  detailedKn         String?
  coverImageUrl      String?
  coverStoragePath   String?         @unique
  logoUrl            String?
  logoStoragePath    String?         @unique
  startDate          DateTime?
  endDate            DateTime?
  venueEn            String?
  venueKn            String?
  status             MclSeasonStatus @default(PLANNED)
  isPublished        Boolean         @default(false)
  verifiedStatistics Json?
  championTeamId     String?
  runnerUpTeamId     String?
  thirdPlaceTeamId   String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  teams              MclTeam[]       @relation("MclSeasonTeams")
  rosters            MclRoster[]
  awards             MclAward[]
  memories           MclMemory[]
  championTeam       MclTeam?        @relation("MclChampion", fields: [championTeamId], references: [id], onDelete: SetNull)
  runnerUpTeam       MclTeam?        @relation("MclRunnerUp", fields: [runnerUpTeamId], references: [id], onDelete: SetNull)
  thirdPlaceTeam     MclTeam?        @relation("MclThirdPlace", fields: [thirdPlaceTeamId], references: [id], onDelete: SetNull)
  createdBy          UserProfile?    @relation("MclSeasonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          UserProfile?    @relation("MclSeasonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublished, year])
  @@map("mcl_seasons")
}

model MclTeam {
  id              String      @id @default(uuid())
  seasonId        String
  nameEn          String
  nameKn          String?
  descriptionEn   String?
  descriptionKn   String?
  captain         String?
  logoUrl         String?
  logoStoragePath String?     @unique
  finalPosition   Int?
  matchesPlayed   Int?
  wins            Int?
  losses          Int?
  points          Int?
  runs            Int?
  wickets         Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  season          MclSeason   @relation("MclSeasonTeams", fields: [seasonId], references: [id], onDelete: Cascade)
  rosters         MclRoster[]
  awards          MclAward[]
  championOf      MclSeason[] @relation("MclChampion")
  runnerUpOf      MclSeason[] @relation("MclRunnerUp")
  thirdPlaceOf    MclSeason[] @relation("MclThirdPlace")

  @@unique([seasonId, nameEn])
  @@index([seasonId, finalPosition])
  @@map("mcl_teams")
}

model MclPlayer {
  id               String         @id @default(uuid())
  nameEn           String
  nameKn           String?
  photoUrl         String?
  photoStoragePath String?        @unique
  alumniProfileId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  alumniProfile    AlumniProfile? @relation(fields: [alumniProfileId], references: [id], onDelete: SetNull)
  rosters          MclRoster[]
  awards           MclAward[]

  @@index([nameEn])
  @@index([alumniProfileId])
  @@map("mcl_players")
}

model MclRoster {
  id           String    @id @default(uuid())
  seasonId     String
  teamId       String
  playerId     String
  jerseyNumber Int?
  role         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  season       MclSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team         MclTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       MclPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@index([teamId])
  @@map("mcl_rosters")
}

model MclAward {
  id               String     @id @default(uuid())
  seasonId         String
  awardNameEn      String
  awardNameKn      String?
  descriptionEn    String?
  descriptionKn    String?
  playerId         String?
  teamId           String?
  statistics       Json?
  awardImageUrl    String?
  awardStoragePath String?    @unique
  isPublished      Boolean    @default(true)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  season           MclSeason  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player           MclPlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  team             MclTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([seasonId, isPublished, sortOrder])
  @@map("mcl_awards")
}

model MclMemory {
  id           String       @id @default(uuid())
  seasonId     String
  imageUrl     String
  storagePath  String       @unique
  captionEn    String?
  captionKn    String?
  altText      String
  category     String       @default("MEMORIES")
  date         DateTime?
  isFeatured   Boolean      @default(false)
  isPublished  Boolean      @default(false)
  sortOrder    Int          @default(0)
  uploadedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  season       MclSeason    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  uploadedBy   UserProfile? @relation("MclMemoryUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([seasonId, isPublished, sortOrder])
  @@index([category])
  @@map("mcl_memories")
}

model FinancialYear {
  id             String                 @id @default(uuid())
  name           String                 @unique
  startDate      DateTime
  endDate        DateTime
  openingBalance Decimal                @default(0) @db.Decimal(14, 2)
  isCurrent      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  transactions   FinancialTransaction[]
  documents      Document[]

  @@index([isCurrent])
  @@map("financial_years")
}

model FinancialCategory {
  id           String                 @id @default(uuid())
  name         String                 @unique
  type         TransactionType?
  active       Boolean                @default(true)
  transactions FinancialTransaction[]

  @@map("financial_categories")
}

model FinancialTransaction {
  id              String            @id @default(uuid())
  financialYearId String
  categoryId      String
  eventId         String?
  createdById     String?
  type            TransactionType
  date            DateTime
  particulars     String
  amount          Decimal           @db.Decimal(14, 2)
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  documentPath    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  category        FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  event           Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy       UserProfile?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([financialYearId, date])
  @@index([eventId])
  @@index([type])
  @@map("financial_transactions")
}

model Document {
  id              String         @id @default(uuid())
  name            String
  description     String?
  storagePath     String         @unique
  financialYearId String?
  uploadedAt      DateTime       @default(now())
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id], onDelete: SetNull)

  @@map("documents")
}

model AuditLog {
  id         String       @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  createdAt  DateTime     @default(now())
  user       UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Feedback {
  id           String   @id @default(uuid())
  referenceId  String   @unique
  fullName     String
  email        String
  batch        String
  alumniType   String
  feedbackType String
  subject      String?
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}
