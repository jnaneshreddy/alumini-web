generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum GalleryType {
  PHOTO_GALLERY
  MEMORY
}

enum GalleryCategory {
  SCHOOL_MEMORIES
  CAMPUS
  EVENTS
  ALUMNI
  REUNIONS
  TEACHERS
  STUDENT_LIFE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum AlumniVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AlumniRegistrantType {
  ALUMNI
  STUDENT
  TEACHER
}

model UserProfile {
  id              String                 @id @default(uuid())
  authUserId      String                 @unique
  email           String                 @unique
  fullName        String
  role            Role                   @default(USER)
  active          Boolean                @default(true)
  phone           String?
  batch           String?
  avatarUrl       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  transactions    FinancialTransaction[]
  auditLogs       AuditLog[]
  galleryImages   GalleryImage[]
  alumniCreated   AlumniProfile[]        @relation("AlumniCreatedBy")
  alumniVerified  AlumniProfile[]        @relation("AlumniVerifiedBy")
  notifications   AdminNotification[]
  settingsUpdates SiteSettings[]         @relation("SettingsUpdatedBy")
  teachersCreated Teacher[]              @relation("TeacherCreatedBy")
  teachersUpdated Teacher[]              @relation("TeacherUpdatedBy")

  @@map("user_profiles")
}

model AlumniProfile {
  id                 String                   @id @default(uuid())
  fullName           String
  registrantType     AlumniRegistrantType     @default(ALUMNI)
  email              String?
  phone              String?
  batch              String
  graduationYear     Int?
  city               String?
  profession         String?
  bio                String?
  avatarUrl          String?
  consentToPublish   Boolean                  @default(false)
  consentRecordedAt  DateTime?
  verificationStatus AlumniVerificationStatus @default(PENDING)
  isPublished        Boolean                  @default(false)
  createdById        String?
  verifiedById       String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  createdBy          UserProfile?             @relation("AlumniCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedBy         UserProfile?             @relation("AlumniVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([batch, verificationStatus])
  @@index([isPublished, verificationStatus])
  @@map("alumni_profiles")
}

model AdminNotification {
  id          String      @id @default(uuid())
  recipientId String
  title       String
  message     String
  category    String      @default("SYSTEM")
  href        String?
  readAt      DateTime?
  clearedAt   DateTime?
  createdAt   DateTime    @default(now())
  recipient   UserProfile @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, clearedAt, createdAt])
  @@index([recipientId, readAt])
  @@map("admin_notifications")
}

model SiteSettings {
  id               String       @id
  organizationName String       @default("Morarji Desai Residential School")
  portalName       String       @default("MDRS Alumni")
  supportEmail     String?
  supportPhone     String?
  timezone         String       @default("Asia/Kolkata")
  notifyFeedback   Boolean      @default(true)
  notifyAlumni     Boolean      @default(true)
  notifyAccess     Boolean      @default(true)
  updatedById      String?
  updatedAt        DateTime     @updatedAt
  updatedBy        UserProfile? @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model CarouselSlide {
  id        String        @id @default(uuid())
  title     String
  caption   String?
  imagePath String
  altText   String
  position  Int           @default(0)
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, position])
  @@map("carousel_slides")
}

model Announcement {
  id          String        @id @default(uuid())
  title       String
  titleKn     String?
  body        String
  bodyKn      String?
  priority    String        @default("GENERAL")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("announcements")
}

model Event {
  id            String                 @id @default(uuid())
  title         String
  titleKn       String?
  description   String?
  descriptionKn String?
  eventDate     DateTime
  startTime     String?
  endTime       String?
  venue         String?
  venueKn       String?
  imagePath     String?
  status        EventStatus            @default(UPCOMING)
  publication   PublishStatus          @default(DRAFT)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  transactions  FinancialTransaction[]
  galleryImages GalleryImage[]

  @@index([eventDate, publication])
  @@map("events")
}

model GalleryImage {
  id            String          @id @default(uuid())
  titleEn       String?
  titleKn       String?
  descriptionEn String?
  descriptionKn String?
  altText       String
  imageUrl      String
  storagePath   String?         @unique
  thumbnailUrl  String?
  category      GalleryCategory @default(SCHOOL_MEMORIES)
  galleryType   GalleryType     @default(PHOTO_GALLERY)
  eventId       String?
  date          DateTime?
  isFeatured    Boolean         @default(false)
  isPublished   Boolean         @default(false)
  sortOrder     Int             @default(0)
  uploadedById  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  event         Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploadedBy    UserProfile?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([galleryType, isPublished, isFeatured, sortOrder])
  @@index([category, isPublished])
  @@index([eventId])
  @@map("gallery_images")
}

model Teacher {
  id            String       @id @default(uuid())
  nameEn        String
  nameKn        String?
  designationEn String
  designationKn String?
  descriptionEn String?
  descriptionKn String?
  imageUrl      String
  storagePath   String?      @unique
  startYear     Int
  endYear       Int?
  isCurrent     Boolean      @default(false)
  isPublished   Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String?
  updatedById   String?
  createdBy     UserProfile? @relation("TeacherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     UserProfile? @relation("TeacherUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublished, isCurrent, endYear, startYear])
  @@map("teachers")
}

model FinancialYear {
  id             String                 @id @default(uuid())
  name           String                 @unique
  startDate      DateTime
  endDate        DateTime
  openingBalance Decimal                @default(0) @db.Decimal(14, 2)
  isCurrent      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  transactions   FinancialTransaction[]
  documents      Document[]

  @@index([isCurrent])
  @@map("financial_years")
}

model FinancialCategory {
  id           String                 @id @default(uuid())
  name         String                 @unique
  type         TransactionType?
  active       Boolean                @default(true)
  transactions FinancialTransaction[]

  @@map("financial_categories")
}

model FinancialTransaction {
  id              String            @id @default(uuid())
  financialYearId String
  categoryId      String
  eventId         String?
  createdById     String?
  type            TransactionType
  date            DateTime
  particulars     String
  amount          Decimal           @db.Decimal(14, 2)
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  documentPath    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  category        FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  event           Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy       UserProfile?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([financialYearId, date])
  @@index([eventId])
  @@index([type])
  @@map("financial_transactions")
}

model Document {
  id              String         @id @default(uuid())
  name            String
  description     String?
  storagePath     String         @unique
  financialYearId String?
  uploadedAt      DateTime       @default(now())
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id], onDelete: SetNull)

  @@map("documents")
}

model AuditLog {
  id         String       @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  createdAt  DateTime     @default(now())
  user       UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Feedback {
  id           String   @id @default(uuid())
  referenceId  String   @unique
  fullName     String
  email        String
  batch        String
  alumniType   String
  feedbackType String
  subject      String?
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}
